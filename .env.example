# Название приложения (бэкенд; фронтенд берёт его же, если не задан VITE_APP_NAME)
APP_NAME=D2Helper

# Публичный адрес сайта без слэша на конце (realm и return_to для входа через Steam).
# Пусто — адрес определяется по входящему запросу (удобно в разработке:
# docker compose → http://localhost:8000, Vite dev → http://localhost:5173).
# В продакшене задавать обязательно.
PUBLIC_URL=
HTTP_ADDR=:8080
# Для локального `go run`. В docker compose переопределяется на хост postgres.
DATABASE_URL=postgres://d2:d2@localhost:5432/d2?sslmode=disable
# Случайная строка от 32 символов: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-32-bytes
COOKIE_SECURE=false

OPENDOTA_API_KEY=
# лимит запросов к OpenDota в минуту (без ключа у них около 60)
OPENDOTA_RATE_PER_MIN=50
# токен с https://stratz.com/api — аккаунту нужно 100+ публичных матчей
STRATZ_TOKEN=
STRATZ_RATE_PER_MIN=120
STEAM_API_KEY=

PATCH_LABEL=7.41F
META_BRACKET=ALL
META_MIN_MATCHES=200

# оценка тренировки драфтера: score = 50 + raw × SCALE (по реальным данным: случайный драфт ≈ 50, почти идеальный ≈ 90)
DRAFTER_SCORE_SCALE=1.1
DRAFTER_META_WEIGHT=10
DRAFTER_OFFPOS_PENALTY=3
DRAFTER_TRAININGS_PER_HOUR=60

# Глубокий разбор матчей — бесплатный. Модель — любая OpenAI-совместимая.
FEATURE_DEEP_ANALYSIS=true
# вариант 1 (по умолчанию): OpenRouter с бесплатными моделями — ключ на https://openrouter.ai/keys
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# модели через запятую: пробуются по порядку, пока одна не ответит
# (openrouter/free сам выбирает свободную бесплатную модель)
LLM_MODEL=openrouter/free,google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free
# вариант 2: локальная модель в Ollama, ключ не нужен:
#   LLM_BASE_URL=http://host.docker.internal:11434/v1
#   LLM_MODEL=qwen2.5:7b
# дневной лимит разборов на пользователя и сколько разборов идёт одновременно
ANALYSES_PER_DAY=3
ANALYSIS_MAX_PARALLEL=2

SUPPORT_URL=
SUPPORT_CONTACT=
PROMO_IMAGE_URL=
PROMO_LINK=

TELEGRAM_FEEDBACK_BOT_TOKEN=
TELEGRAM_FEEDBACK_CHAT_ID=

# debug | info | warn | error
LOG_LEVEL=info
# text | json
LOG_FORMAT=text

# Порты на хосте для docker compose
FRONTEND_PORT=8000
